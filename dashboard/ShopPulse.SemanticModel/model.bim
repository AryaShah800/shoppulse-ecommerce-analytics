        "partitions": [
          {
            "name": "Orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"fct_orders.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers,{{\"order_id\", type text},{\"customer_id\", type text},{\"customer_unique_id\", type text},{\"customer_state\", type text},{\"order_status\", type text},{\"purchased_at\", type datetime},{\"approved_at\", type datetime},{\"shipped_at\", type datetime},{\"delivered_at\", type datetime},{\"estimated_delivery_at\", type datetime},{\"purchase_month\", type date},{\"customer_order_seq\", Int64.Type},{\"n_items\", Int64.Type},{\"item_value\", type number},{\"freight_value\", type number},{\"payment_value\", type number},{\"review_score\", Int64.Type},{\"reached_approved\", type logical},{\"reached_carrier\", type logical},{\"reached_delivered\", type logical},{\"hrs_purchase_to_approval\", type number},{\"hrs_approval_to_carrier\", type number},{\"hrs_carrier_to_customer\", type number},{\"hrs_purchase_to_delivery\", type number},{\"is_late\", type logical},{\"days_vs_estimate\", Int64.Type}},\"en-US\"),",
                "    WithDate = Table.AddColumn(Typed,\"purchase_date\",each Date.From([purchased_at]),type date),",
                "    Window = Table.SelectRows(WithDate, each [purchase_date] >= #date(2017,1,1) and [purchase_date] <= #date(2018,8,31))",
                "in",
                "    Window"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Orders",
            "expression": "COUNTROWS(Orders)",
            "formatString": "#,##0",
            "lineageTag": "967e677e-4093-482b-9ae9-f00936656fd8"
          },
          {
            "name": "Delivered Orders",
            "expression": "CALCULATE([Orders],Orders[reached_delivered]=TRUE())",
            "formatString": "#,##0",
            "lineageTag": "dc7f7677-3f94-41f3-b0f3-f6e53d88d419"
          },
          {
            "name": "Delivered %",
            "expression": "DIVIDE([Delivered Orders],[Orders])",
            "formatString": "0.00%",
            "lineageTag": "c97f11b7-3c34-443e-8d88-eacc83836774"
          },
          {
            "name": "Revenue R$",
            "expression": "CALCULATE(SUM(Orders[item_value]),Orders[reached_delivered]=TRUE())",
            "formatString": "\"R$ \"#,##0.00",
            "lineageTag": "52534db2-ea36-4e38-bbd6-ba1e5c9ef3f7"
          },
          {
            "name": "AOV R$",
            "expression": "DIVIDE([Revenue R$],[Delivered Orders])",
            "formatString": "\"R$ \"#,##0.00",
            "lineageTag": "fafda5a6-77a4-48d7-aace-107c1115ac0c"
          },
          {
            "name": "On-time %",
            "expression": "DIVIDE(CALCULATE([Orders],Orders[is_late]=FALSE(),NOT ISBLANK(Orders[is_late])),CALCULATE([Orders],NOT ISBLANK(Orders[is_late])))",
            "formatString": "0.00%",
            "lineageTag": "7731a893-d064-44e8-8d08-1da0016503e5"
          },
          {
            "name": "Average Review",
            "expression": "AVERAGE(Orders[review_score])",
            "formatString": "0.00",
            "lineageTag": "af8b29f4-edde-4ad8-a8cb-3c9d96270a5a"
          },
          {
            "name": "Funnel Orders",
            "expression": "SWITCH(SELECTEDVALUE(Stages[step]),1,[Orders],2,CALCULATE([Orders],Orders[reached_approved]=TRUE()),3,CALCULATE([Orders],Orders[reached_carrier]=TRUE()),4,[Delivered Orders])",
            "formatString": "#,##0",
            "lineageTag": "916bad32-c922-4d2f-a6d5-5583d3a63dcc"
          },
          {
            "name": "Median Days",
            "expression": "MAX(Durations[median_days])",
            "formatString": "0.00",
            "lineageTag": "df7b5dd9-4c4f-419b-bc0e-c13ccf025481"
          },
          {
            "name": "P90 Days",
            "expression": "MAX(Durations[p90_days])",
            "formatString": "0.00",
            "lineageTag": "f094cedb-6233-4fab-b8ea-454c8f84d9b0"
          },
          {
            "name": "Repeat Customers % snapshot",
            "expression": "MAX(RepeatSnapshot[repeat_customer_pct])/100",
            "formatString": "0.00%",
            "lineageTag": "b14f44e6-606f-41fd-b4ca-2f03cd253e12"
          },
          {
            "name": "RFM Customers",
            "expression": "SUM(RFM[customers])",
            "formatString": "#,##0",
            "lineageTag": "4c11644b-acc9-4cff-a48d-74201c787e7e"
          },
          {
            "name": "RFM Revenue R$",
            "expression": "SUM(RFM[revenue_brl])",
            "formatString": "\"R$ \"#,##0",
            "lineageTag": "250d6eb0-cc06-4acd-adc3-921471572371"
          },
          {
            "name": "Cohort Retention %",
            "expression": "MAX(Cohorts[retention_pct])/100",
            "formatString": "0.00%",
            "lineageTag": "c13ae6f3-2b09-4e16-8fd6-e8aa59d4615c"
          },
          {
            "name": "Low Review %",
            "expression": "VAR lateFlag=SELECTEDVALUE(LateStatus[is_late]) RETURN DIVIDE(CALCULATE(COUNTROWS(Reviews),Reviews[is_low_review]=TRUE(),Reviews[is_late]=lateFlag),CALCULATE(COUNTROWS(Reviews),Reviews[is_late]=lateFlag))",
            "formatString": "0.0%",
            "lineageTag": "c24d8aa2-70e0-42fe-a04a-233befcb2bb2"
          },
          {
            "name": "Repeat Rate fixed cohort",
            "expression": "MAX(RepeatRates[rate])",
            "formatString": "0.00%",
            "lineageTag": "5c2974bc-c097-4287-9b1c-ddfd9d4d4d0d"
          },
          {
            "name": "Dose Low Review % fixed",
            "expression": "MAX(Dose[low_review_rate])",
            "formatString": "0.0%",
            "lineageTag": "aa08a515-bd35-4098-9141-dadf385b9a1a"
          },
          {
            "name": "Dose Repeat % fixed",
            "expression": "MAX(Dose[repeat_rate])",
            "formatString": "0.00%",
            "lineageTag": "2363f625-b38c-493b-8970-6ed97b01c138"
          },
          {
            "name": "Gap pp fixed cohort",
            "expression": "0.5160306112605836",
            "formatString": "0.00\" pp\"",
            "lineageTag": "6f6324ba-f4c0-4ea7-b6cd-491e24c37a7b"
          },
          {
            "name": "Illustrative Scenario R$",
            "expression": "VAR people=IF(ISFILTERED(CustomersAssumption[customers]),MAX(CustomersAssumption[customers]),2668) VAR gap=IF(ISFILTERED(GapAssumption[gap_pp]),MAX(GapAssumption[gap_pp]),0.5160306112605836) RETURN people*gap/100*120.40201663201665",
            "formatString": "\"R$ \"#,##0.00",
            "lineageTag": "b43903b0-a084-44a5-84cf-bd7e954ee6de"
          }
        ]
      },
